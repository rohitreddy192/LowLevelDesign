#!/bin/sh
#
# Prevent direct commits to protected branches (main/master).
# Changes must go through a feature branch and a pull request.

branch="$(git rev-parse --abbrev-ref HEAD)"

protected_branches="main master"

for protected in $protected_branches; do
	if [ "$branch" = "$protected" ]; then
		echo "----------------------------------------------------------------"
		echo "ERROR: Direct commits to '$branch' are not allowed."
		echo "Please create a feature branch and open a pull request:"
		echo ""
		echo "    git switch -c my-feature-branch"
		echo ""
		echo "Then commit your changes and push the branch to open a PR."
		echo "----------------------------------------------------------------"
		exit 1
	fi
done

exit 0
